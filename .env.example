# 複製為 .env 後填入自己的值；.env 已列入 .gitignore，切勿提交金鑰。

# =============================================
# LiteLLM（Chat Completion）——以下兩種方式擇一
# 範例變數預設皆為註解，避免佔位值意外啟用 proxy 路徑。
# =============================================
# (A) OpenAI-compatible proxy：LITELLM_BASE_URL 與 LITELLM_API_KEY 須「同時」設定，
#     程式才會改走 proxy，並以 openai/<model> 呼叫（避免 gemini-* 被導向 Vertex AI；
#     模型名稱已含 "/" 時原樣使用）。
# LITELLM_BASE_URL=https://your-litellm-endpoint.example.com
# LITELLM_API_KEY=your_proxy_key_here
# LITELLM_MODEL=gemini-2.5-flash
#
# (B) 直接使用供應商金鑰（LiteLLM 會自動讀取對應的環境變數；此時不要設定上面兩個 proxy 變數）
#   OpenAI：
# OPENAI_API_KEY=your_openai_key_here
# LITELLM_MODEL=gpt-4.1-mini
#   Google Gemini（AI Studio）：模型名稱須加 gemini/ 前綴；單寫 gemini-2.5-flash 會被導向 Vertex AI
# GEMINI_API_KEY=your_gemini_key_here
# LITELLM_MODEL=gemini/gemini-2.5-flash
#
# 未設定 LITELLM_MODEL 時預設為 gemini-2.5-flash（只適用於 (A) proxy）。

# =============================================
# Embedding：sentence-transformers 本地（免費）
# 此模型的 max_seq_length 為 128 tokens，超過的部分在 embedding 時會被截斷。
# =============================================
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# =============================================
# Chroma 持久化目錄（相對路徑以專案根目錄為基準）
# 每個 collection 的 BM25 索引也存在此目錄：bm25_<collection>.json
# =============================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=cypher_og

# =============================================
# 可選：chunk 參數
# =============================================
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100

# =============================================
# 可選：RAG 檢索過濾（cosine distance，0=完全相同，1=完全不似）
# Hybrid Search 時此門檻只作用於向量通道。
# =============================================
# MAX_DISTANCE=0.65
